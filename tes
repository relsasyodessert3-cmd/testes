<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LUMINA KAFE - Artisan Coffee & Culinary Comfort</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Alpine.js for Interactive Logic -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- Google Fonts: Plus Jakarta Sans & Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        lumina: {
                            bg: '#121214',
                            card: '#1c1c20',
                            cardHover: '#25252b',
                            border: '#2e2e36',
                            amber: '#f59e0b',
                            gold: '#fbbf24',
                            glow: '#d97706',
                            cream: '#fef3c7',
                            muted: '#a1a1aa'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        serif: ['"Playfair Display"', 'serif'],
                    },
                    boxShadow: {
                        'glow-amber': '0 0 25px -5px rgba(245, 158, 11, 0.25)',
                        'glow-lg': '0 0 40px -10px rgba(245, 158, 11, 0.35)',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #121214;
            color: #f4f4f5;
            font-family: 'Plus Jakarta Sans', sans-serif;
            overflow-x: hidden;
        }
        
        /* Custom Ambient Lighting Effects */
        .ambient-glow {
            background: radial-gradient(circle at 50% -20%, rgba(245, 158, 11, 0.18), transparent 70%);
        }
        
        .card-glow:hover {
            box-shadow: 0 10px 30px -10px rgba(245, 158, 11, 0.2);
            border-color: rgba(245, 158, 11, 0.4);
        }

        /* Hide scrollbar for Chrome, Safari and Opera */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        /* Hide scrollbar for IE, Edge and Firefox */
        .no-scrollbar {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }

        .glass-panel {
            background: rgba(28, 28, 32, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
    </style>
</head>
<body x-data="luminaApp()" x-init="initApp()" class="min-h-screen flex flex-col antialiased selection:bg-lumina-amber selection:text-black">

    <!-- NAVIGATION BAR -->
    <nav class="sticky top-0 z-40 glass-panel border-b border-lumina-border/60 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- Logo & Brand -->
                <a href="#" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-lumina-glow to-lumina-gold flex items-center justify-center text-black font-bold shadow-glow-amber transition-transform group-hover:scale-105">
                        <i data-lucide="coffee" class="w-5 h-5 text-zinc-950"></i>
                    </div>
                    <div>
                        <span class="font-serif text-xl sm:text-2xl font-bold tracking-wider text-white block leading-none">LUMINA</span>
                        <span class="text-[10px] tracking-[0.2em] text-lumina-amber font-semibold uppercase">Kafe & Resto</span>
                    </div>
                </a>

                <!-- Desktop Nav Links -->
                <div class="hidden md:flex items-center space-x-8 text-sm font-medium text-zinc-300">
                    <a href="#hero" class="hover:text-lumina-amber transition-colors">Beranda</a>
                    <a href="#pairing" class="hover:text-lumina-amber transition-colors flex items-center gap-1.5">
                        <i data-lucide="sparkles" class="w-4 h-4 text-lumina-gold"></i>
                        Mood & Pairing
                    </a>
                    <a href="#menu" class="hover:text-lumina-amber transition-colors">Daftar Menu</a>
                    <a href="#about" class="hover:text-lumina-amber transition-colors">Informasi</a>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-3">
                    <!-- Table Reservation Button -->
                    <button @click="openReservationModal = true" 
                            class="hidden sm:flex items-center gap-2 px-4 py-2.5 rounded-full border border-lumina-amber/40 bg-lumina-amber/10 hover:bg-lumina-amber/20 text-lumina-cream text-xs font-semibold tracking-wide transition-all">
                        <i data-lucide="calendar" class="w-4 h-4 text-lumina-amber"></i>
                        <span>Reservasi Meja</span>
                    </button>

                    <!-- Cart Toggle Button -->
                    <button @click="cartOpen = true" 
                            class="relative p-2.5 sm:px-4 sm:py-2.5 rounded-full bg-lumina-amber hover:bg-lumina-gold text-zinc-950 font-bold text-xs flex items-center gap-2 transition-all transform active:scale-95 shadow-glow-amber">
                        <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Pesanan</span>
                        <span x-show="cartTotalItems > 0" 
                              x-text="cartTotalItems" 
                              class="w-5 h-5 rounded-full bg-zinc-950 text-lumina-gold text-[11px] font-extrabold flex items-center justify-center">
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section id="hero" class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden ambient-glow">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <!-- Hero Text -->
                <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                    
                    <!-- Open/Closed Live Status Badge -->
                    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-zinc-900/80 border border-zinc-800 backdrop-blur-md">
                        <span class="relative flex h-2.5 w-2.5">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                        </span>
                        <span class="text-xs font-medium text-zinc-300">Buka Hari Ini: <span class="text-white font-semibold">10:00 - 22:00 WIB</span></span>
                    </div>

                    <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-[1.15]">
                        Artisan Coffee & <br class="hidden sm:inline"/>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-lumina-gold via-amber-400 to-amber-600">Culinary Comfort</span>
                    </h1>

                    <p class="text-zinc-400 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed font-light">
                        Selamat datang di <strong class="text-white font-medium">Lumina Kafe</strong>. Menghadirkan kehangatan kopi pilihan bercita rasa tinggi dan hidangan kuliner yang diracik segar dari bahan lokal berkualitas.
                    </p>

                    <!-- Kitchen Note Highlight -->
                    <div class="p-4 rounded-xl bg-lumina-card/90 border border-lumina-border flex items-start gap-3.5 text-left max-w-xl mx-auto lg:mx-0">
                        <i data-lucide="sparkles" class="w-5 h-5 text-lumina-amber shrink-0 mt-0.5"></i>
                        <div class="text-xs text-zinc-300 leading-relaxed">
                            <strong class="text-lumina-gold block font-semibold mb-0.5">Catatan Dapur & Spesial Hari Ini:</strong>
                            Semua hidangan dimasak segar saat dipesan dengan bahan lokal pilihan. Harap beri tahu staf kami jika Anda memiliki alergi terhadap bahan makanan tertentu.
                        </div>
                    </div>

                    <!-- Call to Actions -->
                    <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-2">
                        <a href="#menu" class="px-7 py-3.5 rounded-full bg-lumina-amber hover:bg-lumina-gold text-zinc-950 font-bold text-sm transition-all shadow-glow-amber flex items-center gap-2">
                            <span>Jelajahi Menu</span>
                            <i data-lucide="arrow-down" class="w-4 h-4"></i>
                        </a>
                        <button @click="openReservationModal = true" class="px-7 py-3.5 rounded-full bg-zinc-900 border border-zinc-700 hover:border-lumina-amber/50 text-white font-semibold text-sm transition-all flex items-center gap-2">
                            <i data-lucide="utensils" class="w-4 h-4 text-lumina-amber"></i>
                            <span>Reservasi Tempat</span>
                        </button>
                    </div>

                </div>

                <!-- Hero Visual / Feature Card Showcase -->
                <div class="lg:col-span-5 relative">
                    <div class="relative mx-auto max-w-md lg:max-w-none">
                        <!-- Decorative Glow Effect Background -->
                        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-lumina-amber to-amber-700 opacity-30 blur-2xl"></div>
                        
                        <!-- Hero Main Card -->
                        <div class="relative rounded-3xl bg-lumina-card border border-lumina-border p-6 shadow-2xl space-y-5">
                            <div class="relative h-64 sm:h-72 rounded-2xl overflow-hidden group">
                                <img src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=800&q=80" 
                                     alt="Lumina Kafe Atmosphere" 
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                                <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent"></div>
                                <div class="absolute bottom-4 left-4 right-4">
                                    <span class="px-2.5 py-1 rounded-md bg-lumina-amber text-zinc-950 text-[11px] font-extrabold uppercase tracking-wider mb-2 inline-block">Favorit Pelanggan</span>
                                    <h3 class="font-serif text-xl font-bold text-white">Es Kopi Susu Gula Aren</h3>
                                    <p class="text-xs text-zinc-300 mt-1">Espresso kental, susu segar, dan gula aren organik pilihan.</p>
                                </div>
                            </div>

                            <!-- Quick Stats Badge Row -->
                            <div class="grid grid-cols-3 gap-3 text-center">
                                <div class="p-3 rounded-xl bg-zinc-900/80 border border-zinc-800">
                                    <span class="block font-serif text-lg font-bold text-lumina-gold">100%</span>
                                    <span class="text-[11px] text-zinc-400">Bahan Segar</span>
                                </div>
                                <div class="p-3 rounded-xl bg-zinc-900/80 border border-zinc-800">
                                    <span class="block font-serif text-lg font-bold text-lumina-gold">4.9 ★</span>
                                    <span class="text-[11px] text-zinc-400">Rating Rasa</span>
                                </div>
                                <div class="p-3 rounded-xl bg-zinc-900/80 border border-zinc-800">
                                    <span class="block font-serif text-lg font-bold text-lumina-gold">20+</span>
                                    <span class="text-[11px] text-zinc-400">Varian Menu</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- AI/SMART MOOD & PAIRING RECOMMENDER -->
    <section id="pairing" class="py-16 bg-zinc-950/60 border-y border-lumina-border/40 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-10">
                <span class="text-xs uppercase tracking-widest text-lumina-amber font-semibold block mb-2">Smart Menu Assistant</span>
                <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white">Bingung Mau Pesan Apa?</h2>
                <p class="text-zinc-400 text-sm mt-2">Pilih mood atau suasana berkunjung Anda, dan biarkan Lumina merekomendasikan pasangan menu sempurna!</p>
            </div>

            <!-- Mood Buttons -->
            <div class="flex flex-wrap justify-center gap-3 mb-10">
                <template x-for="mood in moods" :key="mood.id">
                    <button @click="selectMood(mood.id)" 
                            :class="selectedMood === mood.id ? 'bg-lumina-amber text-zinc-950 border-lumina-amber font-bold shadow-glow-amber' : 'bg-lumina-card text-zinc-300 border-lumina-border hover:border-zinc-500'"
                            class="px-5 py-3 rounded-2xl border text-sm transition-all flex items-center gap-2">
                        <span x-text="mood.icon"></span>
                        <span x-text="mood.label"></span>
                    </button>
                </template>
            </div>

            <!-- Recommendation Display Card -->
            <div x-show="activePairing" x-transition:enter="transition ease-out duration-300 transform opacity-0 scale-95" x-transition:enter-start="opacity-0 scale-95" x-transition:enter-end="opacity-100 scale-100" class="max-w-4xl mx-auto">
                <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-lumina-amber/30 relative overflow-hidden">
                    <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-lumina-amber/10 rounded-full blur-2xl"></div>
                    
                    <div class="flex items-center gap-2 text-lumina-amber font-medium text-xs uppercase tracking-widest mb-4">
                        <i data-lucide="sparkles" class="w-4 h-4"></i>
                        <span>Rekomendasi Kombinasi Ideal</span>
                    </div>

                    <h3 class="text-xl sm:text-2xl font-serif font-bold text-white mb-2" x-text="activePairing.title"></h3>
                    <p class="text-sm text-zinc-300 mb-6" x-text="activePairing.description"></p>

                    <!-- Paired Items Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Food Item -->
                        <div class="p-4 rounded-2xl bg-zinc-900/90 border border-zinc-800 flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-lumina-amber/10 border border-lumina-amber/20 flex items-center justify-center text-xl">
                                    🍔
                                </div>
                                <div>
                                    <span class="text-[10px] text-lumina-amber uppercase font-semibold tracking-wider">Makanan</span>
                                    <h4 class="font-bold text-white text-sm" x-text="activePairing.food.name"></h4>
                                    <p class="text-xs text-zinc-400" x-text="formatRupiah(activePairing.food.price)"></p>
                                </div>
                            </div>
                            <button @click="openModalWithItem(activePairing.food)" class="p-2 rounded-lg bg-lumina-amber/20 hover:bg-lumina-amber text-lumina-gold transition-colors">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                            </button>
                        </div>

                        <!-- Drink Item -->
                        <div class="p-4 rounded-2xl bg-zinc-900/90 border border-zinc-800 flex items-center justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-lumina-amber/10 border border-lumina-amber/20 flex items-center justify-center text-xl">
                                    ☕
                                </div>
                                <div>
                                    <span class="text-[10px] text-lumina-amber uppercase font-semibold tracking-wider">Minuman</span>
                                    <h4 class="font-bold text-white text-sm" x-text="activePairing.drink.name"></h4>
                                    <p class="text-xs text-zinc-400" x-text="formatRupiah(activePairing.drink.price)"></p>
                                </div>
                            </div>
                            <button @click="openModalWithItem(activePairing.drink)" class="p-2 rounded-lg bg-lumina-amber/20 hover:bg-lumina-amber text-lumina-gold transition-colors">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Add Both Combo Button -->
                    <div class="mt-6 flex justify-end">
                        <button @click="addPairingToCart(activePairing)" class="px-6 py-2.5 rounded-xl bg-lumina-amber hover:bg-lumina-gold text-zinc-950 font-bold text-xs flex items-center gap-2 transition-all shadow-glow-amber">
                            <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                            <span>Tambah Paket Kombinasi ke Pesanan</span>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- MAIN INTERACTIVE MENU SECTION -->
    <section id="menu" class="py-20 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
                <div>
                    <span class="text-xs uppercase tracking-widest text-lumina-amber font-semibold block mb-1">Cita Rasa Otentik</span>
                    <h2 class="font-serif text-3xl sm:text-5xl font-bold text-white">Daftar Menu Lumina</h2>
                </div>

                <!-- Search Input Bar -->
                <div class="relative w-full md:w-80">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400"></i>
                    <input type="text" 
                           x-model="searchQuery" 
                           placeholder="Cari hidangan atau minuman..." 
                           class="w-full pl-10 pr-4 py-2.5 rounded-2xl bg-lumina-card border border-lumina-border text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lumina-amber transition-colors">
                    <button x-show="searchQuery" @click="searchQuery = ''" class="absolute right-3 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-white">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <!-- Category Filter Tabs -->
            <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 no-scrollbar">
                <template x-for="cat in categories" :key="cat.id">
                    <button @click="activeCategory = cat.id" 
                            :class="activeCategory === cat.id ? 'bg-lumina-amber text-zinc-950 font-bold shadow-glow-amber' : 'bg-lumina-card text-zinc-400 hover:text-white border border-lumina-border'"
                            class="px-5 py-2.5 rounded-2xl text-xs whitespace-nowrap transition-all flex items-center gap-2">
                        <span x-text="cat.name"></span>
                        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-zinc-900/50" x-text="getCategoryCount(cat.id)"></span>
                    </button>
                </template>
            </div>

            <!-- Menu Cards Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <template x-for="item in filteredMenu" :key="item.id">
                    <div class="group bg-lumina-card rounded-2xl border border-lumina-border p-5 flex flex-col justify-between transition-all duration-300 card-glow">
                        <div>
                            <!-- Badge & Category -->
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-[11px] font-semibold px-2.5 py-1 rounded-md bg-zinc-900 text-lumina-amber border border-zinc-800" x-text="getCategoryLabel(item.category)"></span>
                                <span x-show="item.popular" class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">POPULER</span>
                            </div>

                            <!-- Menu Name & Description -->
                            <h3 class="font-serif text-lg font-bold text-white group-hover:text-lumina-gold transition-colors" x-text="item.name"></h3>
                            <p class="text-xs text-zinc-400 mt-2 line-clamp-2 leading-relaxed" x-text="item.description"></p>
                        </div>

                        <!-- Price & Action Button -->
                        <div class="mt-6 pt-4 border-t border-zinc-800/80 flex items-center justify-between">
                            <div>
                                <span class="text-[10px] text-zinc-500 block uppercase tracking-wider">Harga</span>
                                <span class="text-base font-bold text-lumina-cream" x-text="formatRupiah(item.price)"></span>
                            </div>

                            <button @click="openModalWithItem(item)" 
                                    class="px-4 py-2 rounded-xl bg-zinc-900 hover:bg-lumina-amber text-zinc-200 hover:text-zinc-950 text-xs font-semibold border border-zinc-700 hover:border-lumina-amber transition-all flex items-center gap-1.5 shadow-sm">
                                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                                <span>Pesan</span>
                            </button>
                        </div>
                    </div>
                </template>
            </div>

            <!-- Empty Search State -->
            <div x-show="filteredMenu.length === 0" class="text-center py-16 bg-lumina-card/40 rounded-3xl border border-dashed border-zinc-800">
                <i data-lucide="search-x" class="w-12 h-12 text-zinc-600 mx-auto mb-3"></i>
                <h3 class="text-lg font-semibold text-white">Menu tidak ditemukan</h3>
                <p class="text-xs text-zinc-400 mt-1">Coba kata kunci pencarian lain atau pilih kategori berbeda.</p>
            </div>

        </div>
    </section>

    <!-- ITEM CUSTOMIZATION MODAL -->
    <div x-show="selectedItem" 
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm" 
         x-cloak>
        
        <div @click.away="selectedItem = null" class="w-full max-w-md bg-lumina-card rounded-3xl border border-lumina-border overflow-hidden shadow-2xl space-y-6 p-6">
            
            <!-- Header -->
            <div class="flex items-start justify-between border-b border-zinc-800 pb-4">
                <div>
                    <span class="text-[10px] text-lumina-amber font-semibold uppercase tracking-widest" x-text="getCategoryLabel(selectedItem?.category)"></span>
                    <h3 class="text-xl font-serif font-bold text-white mt-0.5" x-text="selectedItem?.name"></h3>
                    <p class="text-sm font-semibold text-lumina-gold mt-1" x-text="formatRupiah(selectedItem?.price)"></p>
                </div>
                <button @click="selectedItem = null" class="p-1.5 rounded-full bg-zinc-900 text-zinc-400 hover:text-white">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Customization Options -->
            <div class="space-y-4 text-xs">
                
                <!-- Drink Sweetness Option -->
                <template x-if="isDrink(selectedItem?.category)">
                    <div class="space-y-2">
                        <label class="block font-semibold text-zinc-300">Tingkat Kemanisan (Sugar Level):</label>
                        <div class="grid grid-cols-3 gap-2">
                            <button @click="customOptions.sugar = 'Normal Sugar'" 
                                    :class="customOptions.sugar === 'Normal Sugar' ? 'bg-lumina-amber text-zinc-950 font-bold' : 'bg-zinc-900 text-zinc-400 border border-zinc-800'" 
                                    class="py-2 rounded-xl transition-all">Normal Sugar</button>
                            <button @click="customOptions.sugar = 'Less Sugar'" 
                                    :class="customOptions.sugar === 'Less Sugar' ? 'bg-lumina-amber text-zinc-950 font-bold' : 'bg-zinc-900 text-zinc-400 border border-zinc-800'" 
                                    class="py-2 rounded-xl transition-all">Less Sugar</button>
                            <button @click="customOptions.sugar = 'No Sugar'" 
                                    :class="customOptions.sugar === 'No Sugar' ? 'bg-lumina-amber text-zinc-950 font-bold' : 'bg-zinc-900 text-zinc-400 border border-zinc-800'" 
