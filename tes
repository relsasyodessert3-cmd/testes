                // Computed Menu Filtering
                get filteredMenu() {
                    return this.menuItems.filter(item => {
                        const matchesCategory = this.activeCategory === 'all' || item.category === this.activeCategory;
                        const matchesSearch = item.name.toLowerCase().includes(this.searchQuery.toLowerCase()) || 
                                              item.description.toLowerCase().includes(this.searchQuery.toLowerCase());
                        return matchesCategory && matchesSearch;
                    });
                },

                get activePairing() {
                    return this.pairings[this.selectedMood];
                },

                get cartTotalItems() {
                    return this.cart.reduce((sum, item) => sum + item.qty, 0);
                },

                get cartSubtotal() {
                    return this.cart.reduce((sum, item) => sum + item.totalPrice, 0);
                },

                get cartTax() {
                    return Math.round(this.cartSubtotal * 0.10);
                },

                get cartTotal() {
                    return this.cartSubtotal + this.cartTax;
                },

                // Initializer
                initApp() {
                    setTimeout(() => {
                        if (window.lucide) {
                            window.lucide.createIcons();
                        }
                    }, 100);
                },

                // Helper Functions
                formatRupiah(number) {
                    if (!number) return 'Rp 0';
                    return 'Rp ' + number.toLocaleString('id-ID');
                },

                getCategoryCount(catId) {
                    if (catId === 'all') return this.menuItems.length;
                    return this.menuItems.filter(i => i.category === catId).length;
                },

                getCategoryLabel(catId) {
                    const found = this.categories.find(c => c.id === catId);
                    return found ? found.name : catId;
                },

                isDrink(category) {
                    return category === 'kopi' || category === 'minuman_segar';
                },

                selectMood(moodId) {
                    this.selectedMood = moodId;
                    this.$nextTick(() => {
                        if (window.lucide) window.lucide.createIcons();
                    });
                },

                // Modal Actions
                openModalWithItem(item) {
                    this.selectedItem = item;
                    this.customQuantity = 1;
                    this.customOptions = {
                        sugar: 'Normal Sugar',
                        extraShot: false,
                        temp: item.name.includes('(Hot / Iced)') ? 'Dingin (Iced)' : '',
                        spicy: 'Biasa',
                        note: ''
                    };
                    this.$nextTick(() => {
                        if (window.lucide) window.lucide.createIcons();
                    });
                },

                calculateModalTotal() {
                    if (!this.selectedItem) return 0;
                    let base = this.selectedItem.price;
                    if (this.customOptions.extraShot) {
                        base += 5000;
                    }
                    return base * this.customQuantity;
                },

                confirmAddToCart() {
                    if (!this.selectedItem) return;

                    const itemTotal = this.calculateModalTotal();
                    
                    this.cart.push({
                        id: this.selectedItem.id,
                        name: this.selectedItem.name,
                        unitPrice: this.selectedItem.price,
                        totalPrice: itemTotal,
                        qty: this.customQuantity,
                        options: { ...this.customOptions }
                    });

                    this.showToast(`${this.selectedItem.name} ditambahkan ke pesanan!`);
                    this.selectedItem = null;
                },

                addPairingToCart(pairing) {
                    // Add Food
                    this.cart.push({
                        id: pairing.food.id,
                        name: pairing.food.name,
                        unitPrice: pairing.food.price,
                        totalPrice: pairing.food.price,
                        qty: 1,
                        options: { sugar: '', extraShot: false, spicy: 'Biasa', note: 'Paket Kombinasi' }
                    });

                    // Add Drink
                    this.cart.push({
                        id: pairing.drink.id,
                        name: pairing.drink.name,
                        unitPrice: pairing.drink.price,
                        totalPrice: pairing.drink.price,
                        qty: 1,
                        options: { sugar: 'Normal Sugar', extraShot: false, spicy: '', note: 'Paket Kombinasi' }
                    });

                    this.showToast('Paket Kombinasi berhasil ditambahkan!');
                    this.cartOpen = true;
                },

                updateCartQty(index, delta) {
                    const item = this.cart[index];
                    const singleUnitPrice = item.totalPrice / item.qty;
                    item.qty += delta;

                    if (item.qty <= 0) {
                        this.removeFromCart(index);
                    } else {
                        item.totalPrice = singleUnitPrice * item.qty;
                    }
                },

                removeFromCart(index) {
                    this.cart.splice(index, 1);
                    this.showToast('Item berhasil dihapus.');
                },

                processOrder() {
                    if (this.cart.length === 0) return;
                    this.openCheckoutModal = false;
                    this.cart = [];
                    this.showToast('Pesanan berhasil dikirim ke dapur! Silahkan tunggu.');
                },

                submitReservation() {
                    this.openReservationModal = false;
                    this.showToast(`Reservasi atas nama ${this.reservationForm.name} berhasil dibuat!`);
                    this.reservationForm = { name: '', phone: '', date: '', time: '', guests: '2 Orang', notes: '' };
                },

                showToast(msg) {
                    this.toast.message = msg;
                    this.toast.show = true;
                    setTimeout(() => {
                        this.toast.show = false;
                    }, 3000);
                }
            }
        }
